{
	"name": "doxygen-comment",
	"displayName": "Doxygen Comment",
	"publisher": "",
	"description": "C/C++関数の前にDoxygenスタイルのコメントテンプレートを自動生成します。",
	"version": "1.0.0",
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./dist/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "doxygen-comment.generate",
				"title": "Generate Doxygen Comment"
			}
		],
		"keybindings": [
			{
				"command": "doxygen-comment.generate",
				"key": "alt+e f"
			}
		],
		"configuration": {
			"type": "object",
			"title": "Doxygen Comment",
			"properties": {
				"Function Comment.Template": {
					"type": "array",
					"default": [
						"//! @brief\t",
						"//! @param\t",
						"//! @retval\t"
					],
					"description": "doxgenコメントのテンプレート"
				},
				"Function Comment.Display Void": {
					"type": "boolean",
					"default": true,
					"description": "voidの時コメントを生成する"
				}
			}
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run package",
		"compile": "webpack",
		"watch": "webpack --watch",
		"package": "webpack --mode production --devtool hidden-source-map",
		"compile-tests": "tsc -p . --outDir out",
		"watch-tests": "tsc -p . -w --outDir out",
		"pretest": "npm run compile-tests && npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "vscode-test"
	},
	"devDependencies": {
		"@types/axios": "^0.14.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "18.x",
		"@types/vscode": "^1.85.0",
		"@typescript-eslint/eslint-plugin": "^6.13.1",
		"@typescript-eslint/parser": "^6.13.1",
		"@vscode/test-cli": "^0.0.11",
		"@vscode/test-electron": "^2.3.8",
		"eslint": "^8.54.0",
		"ts-loader": "^9.5.1",
		"typescript": "^5.3.2",
		"webpack": "^5.89.0",
		"webpack-cli": "^5.1.4"
	},
	"overrides": {
		"serialize-javascript": "^7.0.3",
		"diff": "^8.0.3"
	}
}
